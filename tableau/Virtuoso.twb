              <format attr="border-style" value="none" />
            </zone-style>
          </zone>
          <zone id="5" type-v2="text" x="1500" y="92000" w="97000" h="6500">
            <formatted-text>
              <run fontname="Avenir Next" fontsize="10">Index: 35% density + 30% chords + 20% high register + 15% leaps. Weights and scale anchors are provisional. Tempo, bowing, fingering, musicality, and performer validation are not included. Source: Mutopia Project / Erik Sandberg, public domain.</run>
            </formatted-text>
          </zone>
        </zone>
      </zones>
