  <dashboards>
    <dashboard name="Virtuoso">
      <style />
      <size maxheight="900" maxwidth="1400" minheight="900" minwidth="1400" />
      <zones>
        <zone id="0" type-v2="layout-basic" x="0" y="0" w="100000" h="100000">
