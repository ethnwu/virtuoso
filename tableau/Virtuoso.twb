            <column name="[Notes per Quarter]" datatype="real" role="measure" type="quantitative" />
            <column name="[Piece]" datatype="string" role="dimension" type="nominal" />
            <column name="[Virtuoso Index]" datatype="real" role="measure" type="quantitative" />
            <column-instance column="[Chord Onsets Pct]" derivation="Sum" name="[sum:Chord Onsets Pct:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Notes per Quarter]" derivation="Sum" name="[sum:Notes per Quarter:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Piece]" derivation="None" name="[none:Piece:nk]" pivot="key" type="nominal" />
            <column-instance column="[Virtuoso Index]" derivation="Sum" name="[sum:Virtuoso Index:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="background-color" value="#fbf8f1" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Circle" />
            <encodings>
              <lod column="[pieces].[none:Piece:nk]" />
              <text column="[pieces].[none:Piece:nk]" />
              <size column="[pieces].[sum:Virtuoso Index:qk]" />
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="color" value="#97602e" />
                <format attr="mark-labels-show" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[pieces].[sum:Chord Onsets Pct:qk]</rows>
        <cols>[pieces].[sum:Notes per Quarter:qk]</cols>
      </table>
    </worksheet>
